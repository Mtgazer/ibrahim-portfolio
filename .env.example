# Supabase Configuration
# Obtain these credentials from your Supabase Project Settings -> API.
# Note: Never expose SUPABASE_SERVICE_ROLE_KEY to client-side code or public repositories.

# Supabase Project URL (used by both server and browser clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (safe for browser/client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
