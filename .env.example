# Supabase Configuration
# Obtain these credentials from your Supabase Project Settings -> API.
# Note: Never expose SUPABASE_SERVICE_ROLE_KEY to client-side code or public repositories.

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Publishable / Anon API Key (Safe for browser/client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
